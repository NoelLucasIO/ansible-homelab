#cloud-config
# Rendered by ipam-vm tasks/build_base_image.yml: golden image for {{ vm_os }}
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard: {layout: us}
  timezone: America/New_York
  network:
    version: 2
    ethernets:
      any: {match: {name: "en*"}, dhcp4: true}
  storage:
    layout: {name: direct}        # ESP + ext4 root, root last: growpart can extend it
  ssh: {install-server: true, allow-pw: false}
  # No installer user: cloud-init creates the users per VM.
  user-data:
    disable_root: true
  packages: {{ (['python3', 'cloud-init'] + vm_base_packages_debian) | to_json }}
  updates: security
  shutdown: poweroff
  late-commands:
    # Seal for cloning: drop the installer's cloud-init/netplan config so the per-VM
    # NoCloud seed is what configures each clone.
    # Globs, not exact names: 26.04 prefixes them (00-subiquity-disable-cloudinit-networking.cfg).
    - rm -f /target/etc/cloud/cloud.cfg.d/*subiquity-disable-cloudinit-networking.cfg /target/etc/cloud/cloud.cfg.d/*curtin-networking.cfg /target/etc/cloud/cloud.cfg.d/*installer*.cfg /target/etc/cloud/cloud-init.disabled
    # Fail the build if any config that disables cloud-init networking is still there.
    - "sh -c '! grep -rlsE \"config:[[:space:]]*disabled\" /target/etc/cloud/cloud.cfg.d/'"
    - rm -f /target/etc/netplan/*.yaml /target/etc/ssh/ssh_host_*
    # net.ifnames=0: the NIC is eth0 from boot. 26.04's dracut initramfs brings it up early,
    # so cloud-init can't rename enp1s0 -> eth0 later ([busy]) and the netplan config never matches.
    - curtin in-target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="net.ifnames=0 console=tty0 console=ttyS0,115200n8"/' /etc/default/grub
    - curtin in-target -- update-grub
    - curtin in-target -- apt-get clean
    - curtin in-target -- cloud-init clean --logs --machine-id
