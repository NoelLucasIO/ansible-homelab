#cloud-config
# Rendered by ipam-vm tasks/build_base_image.yml: golden image for {{ vm_os }}
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard: {layout: us}
  timezone: America/New_York
  network:
    version: 2
    ethernets:
      any: {match: {name: "en*"}, dhcp4: true}
  storage:
    layout: {name: direct}        # ESP + ext4 root, root last: growpart can extend it
  ssh: {install-server: true, allow-pw: false}
  # No installer user: cloud-init creates the users per VM.
  user-data:
    disable_root: true
  packages: {{ (['python3', 'cloud-init'] + vm_base_packages_debian) | to_json }}
  updates: security
  shutdown: poweroff
  late-commands:
    # Seal for cloning: drop the installer's cloud-init/netplan config so the per-VM
    # NoCloud seed is what configures each clone.
    - rm -f /target/etc/cloud/cloud.cfg.d/50-curtin-networking.cfg /target/etc/cloud/cloud.cfg.d/90-installer-network.cfg /target/etc/cloud/cloud.cfg.d/99-installer.cfg /target/etc/cloud/cloud.cfg.d/subiquity-disable-cloudinit-networking.cfg /target/etc/cloud/cloud-init.disabled
    - rm -f /target/etc/netplan/*.yaml /target/etc/ssh/ssh_host_*
    - curtin in-target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty0 console=ttyS0,115200n8"/' /etc/default/grub
    - curtin in-target -- update-grub
    - curtin in-target -- apt-get clean
    - curtin in-target -- cloud-init clean --logs --machine-id
