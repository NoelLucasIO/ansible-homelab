{#- JSON has no comments, so no ansible_managed marker. -#}
{%- set leaf_claims = {
      'minTLSCertDuration': pki_leaf_min,
      'defaultTLSCertDuration': pki_leaf_default,
      'maxTLSCertDuration': pki_leaf_default,
      'disableRenewal': false,
      'allowRenewalAfterExpiry': false} -%}
{%- set leaf_options = {'x509': {'templateFile': '/home/step/templates/leaf.tpl'}} -%}
{%- set config = {
  'root': '/home/step/certs/root_ca.crt',
  'federatedRoots': none,
  'crt': '/home/step/certs/intermediate_ca.crt',
  'key': '/home/step/secrets/intermediate_ca_key',
  'address': ':' ~ pki_ca_port,
  'dnsNames': [pki_ca_fqdn, inventory_hostname, pki_ca_ip, '127.0.0.1', 'localhost'] | unique,
  'metricsAddress': '127.0.0.1:' ~ pki_metrics_port,
  'logger': {'format': 'json'},
  'db': {
    'type': 'postgresql',
    'dataSource': 'postgresql://' ~ pki_db_user ~ '@' ~ pki_pg_host ~ ':' ~ pki_pg_port ~ '/?sslmode=disable',
    'database': pki_db},
  'crl': {
    'enabled': true,
    'generateOnRevoke': true,
    'cacheDuration': '24h',
    'renewPeriod': '16h',
    'idpURL': 'http://' ~ pki_ca_fqdn ~ '/crl'},
  'authority': {
    'claims': {
      'minTLSCertDuration': pki_leaf_min,
      'defaultTLSCertDuration': pki_leaf_default,
      'maxTLSCertDuration': pki_leaf_max,
      'disableRenewal': false},
    'provisioners': [
      {'type': 'ACME',
       'name': 'acme',
       'challenges': pki_acme_challenges,
       'claims': leaf_claims,
       'options': leaf_options},
      {'type': 'JWK',
       'name': 'admin',
       'key': pki_admin_pub,
       'encryptedKey': pki_admin_jwe,
       'claims': {'minTLSCertDuration': pki_leaf_min,
                  'defaultTLSCertDuration': pki_leaf_default,
                  'maxTLSCertDuration': pki_leaf_max},
       'options': leaf_options}]},
  'tls': {'minVersion': 1.2, 'maxVersion': 1.3, 'renegotiation': false}
} -%}
{{ config | to_nice_json(indent=2) }}
