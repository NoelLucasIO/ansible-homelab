# {{ ansible_managed }}
apiVersion: 1
providers:
  - name: {{ pki_name }}
    folder: {{ pki_grafana_folder }}
    type: file
    disableDeletion: true
    allowUiUpdates: true
    updateIntervalSeconds: 60
    options:
      path: /etc/grafana/provisioning/dashboards/{{ pki_name }}
      foldersFromFilesStructure: false
