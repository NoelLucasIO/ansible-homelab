# {{ ansible_managed }}
# Loaded via scrape_config_files: /etc/prometheus/scrape.d/*.yml
scrape_configs:
  - job_name: pki-stepca
    static_configs:
      - targets: ['127.0.0.1:{{ pki_metrics_port }}']
        labels: { pod: {{ pki_name }} }
  - job_name: pki-expiry
    scrape_interval: 60s
    static_configs:
      - targets: ['127.0.0.1:{{ pki_web_port }}']
        labels: { pod: {{ pki_name }} }
