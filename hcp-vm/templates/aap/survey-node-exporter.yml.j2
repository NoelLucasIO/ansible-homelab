# Survey questions for node_exporter.yml ("HCP node_exporter"). With chain=true the step is
# optional: a blank allow list skips it.
{% set opt = chain | default(false) %}
- question_name: node_exporter allowed scrapers
  question_description: "IPv4 addresses or CIDRs allowed to reach :{{ hcp_node_exporter_port }}, comma-separated; everything else is dropped.{{ ' Blank = no node_exporter.' if opt else '' }}"
  variable: hcp_node_exporter_allow
  type: text
  required: {{ (not opt) | lower }}
  default: {{ (hcp_node_exporter_allow if hcp_node_exporter_allow is string else hcp_node_exporter_allow | join(', ')) | to_json }}
  min: {{ 0 if opt else 7 }}
  max: 400
- question_name: node_exporter version
  variable: hcp_node_exporter_version
  type: text
  required: true
  default: {{ hcp_node_exporter_version | to_json }}
  min: 5
  max: 16
