# Survey questions for certificate.yml ("HCP certificate").
- question_name: Lab CA host (inventory host)
  question_description: Runs the pki-ca container (pki/ project)
  variable: hcp_pki_host
  type: text
  required: true
  default: {{ hcp_pki_host | to_json }}
  min: 1
  max: 200
- question_name: Issued-certificates directory on that host
  question_description: <pki_data>/issued, so PKIIssuedCertExpiring warns 30 days ahead. Blank = don't record.
  variable: hcp_pki_issued_dir
  type: text
  required: false
  default: {{ hcp_pki_issued_dir | to_json }}
  min: 0
  max: 400
- question_name: Lifetime (days)
  variable: hcp_cert_days
  type: integer
  required: true
  default: {{ hcp_cert_days | int }}
  min: 2
  max: 365
- question_name: Extra SANs
  question_description: Besides <system>, *.<system> and *.<tenant>.<system> for every tenant; comma-separated
  variable: hcp_cert_extra_sans
  type: text
  required: false
  default: {{ hcp_cert_extra_sans | to_json }}
  min: 0
  max: 1000
- question_name: Issue a new one even if the current certificate is fine
  variable: hcp_cert_force
  type: multiplechoice
  required: true
  default: "false"
  choices: ["false", "true"]
