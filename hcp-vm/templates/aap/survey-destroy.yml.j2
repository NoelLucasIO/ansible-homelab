- question_name: Hypervisor
  variable: hcp_kvm_host
  type: multiplechoice
  required: true
  default: {{ hcp_kvm_host | to_json }}
  choices: {{ aap_kvm_hosts | to_json }}
- question_name: System short name
  variable: hcp_cluster
  type: text
  required: true
  default: {{ hcp_cluster | to_json }}
  min: 1
  max: 31
- question_name: libvirt VM name
  question_description: Blank = short name in upper case
  variable: hcp_vm_name
  type: text
  required: false
  default: ""
  max: 64
- question_name: Back-end IP
  question_description: Identifies the node's NIOS records
  variable: hcp_backend_ip
  type: text
  required: true
  default: {{ hcp_backend_ip | to_json }}
  min: 7
  max: 15
- question_name: Type the VM name to confirm
  variable: confirm
  type: text
  required: true
  default: ""
  min: 1
  max: 64
