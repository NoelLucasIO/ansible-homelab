# {{ ansible_managed }} (backup/clients)
[Unit]
Description=PBS: KVM image backups (virtnbdbackup)
Wants=network-online.target
After=network-online.target
After=libvirtd.service virtqemud.service

[Service]
Type=oneshot
ExecStart={{ pbs_client_lib_dir }}/pbs-backup-vm
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20h
# No PrivateTmp: QEMU (outside this unit's namespace) creates virtnbdbackup's NBD socket in
# /var/tmp, and the job has to see that same /var/tmp.
