# {{ ansible_managed }} (backup/clients)
[Unit]
Description=PBS: File-level backup of this host
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart={{ pbs_client_lib_dir }}/pbs-backup-host
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20h
# PBS client's own temp files
PrivateTmp=true
