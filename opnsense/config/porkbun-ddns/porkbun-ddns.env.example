# Copy to /root/.porkbun-ddns.env on the firewall, chmod 600, fill in the keys.
# Porkbun > Account > API Access; the domain must have "API Access" enabled.
APIKEY='pk1_REPLACE_ME'
SECRET='sk1_REPLACE_ME'
DOMAIN='example.com'
SUB='vpn2'
IFACE='igc0'          # interface whose IPv4 the record should follow
