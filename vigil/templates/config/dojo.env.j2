# {{ ansible_managed }}
# DefectDojo settings for every vigil-dojo-* container (podman --env-file: no quoting).
DD_DEBUG=False
DD_TIME_ZONE={{ vigil_tz }}
DD_DATABASE_URL=postgresql://{{ vigil_dojo_db_user }}:{{ vigil_dojo_db_password | urlencode }}@{{ vigil_pg_host }}:{{ vigil_pg_port }}/{{ vigil_dojo_db }}
DD_DATABASE_READINESS_TIMEOUT=60
DD_CELERY_BROKER_URL=redis://127.0.0.1:{{ vigil_dojo_valkey_port }}/0
DD_CACHE_URL=redis://127.0.0.1:{{ vigil_dojo_valkey_port }}/1
DD_UWSGI_ENDPOINT=127.0.0.1:{{ vigil_dojo_uwsgi_port }}
DD_SECRET_KEY={{ vigil_dojo_secret_key }}
DD_CREDENTIAL_AES_256_KEY={{ vigil_dojo_aes_key }}
DD_ALLOWED_HOSTS={{ vigil_dojo_fqdn }},127.0.0.1,localhost
DD_SITE_URL=https://{{ vigil_dojo_fqdn }}
DD_CSRF_TRUSTED_ORIGINS=https://{{ vigil_dojo_fqdn }}
DD_SECURE_PROXY_SSL_HEADER=True
DD_SESSION_COOKIE_SECURE=True
DD_CSRF_COOKIE_SECURE=True
DD_DJANGO_METRICS_ENABLED=True
DD_INITIALIZE=true
DD_ADMIN_USER={{ vigil_dojo_admin_user }}
DD_ADMIN_MAIL={{ vigil_dojo_admin_mail }}
DD_ADMIN_PASSWORD={{ vigil_dojo_admin_password }}
