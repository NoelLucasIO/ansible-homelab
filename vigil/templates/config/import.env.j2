# {{ ansible_managed }}
# Read by {{ vigil_libexec }}/vigil-import (root only).
DOJO_URL=http://127.0.0.1:{{ vigil_dojo_port }}
DOJO_USER={{ vigil_dojo_admin_user | quote }}
DOJO_PASSWORD={{ vigil_dojo_admin_password | quote }}
PRODUCT_TYPE="{{ vigil_dojo_product_type }}"
ENGAGEMENT="{{ vigil_dojo_engagement }}"
REPORTS={{ vigil_data }}/reports
KEEP_DAYS={{ vigil_report_keep_days }}
# scope name -> DefectDojo product
declare -A PRODUCT=(
{% for s in vigil_scopes %}
  [{{ s.name }}]="{{ s.product }}"
{% endfor %}
  [web]="{{ vigil_web_product }}"
)
