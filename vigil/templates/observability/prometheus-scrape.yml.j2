# {{ ansible_managed }}
# Loaded via scrape_config_files: /etc/prometheus/scrape.d/*.yml
scrape_configs:
  - job_name: vigil-defectdojo
    metrics_path: /django_metrics/metrics   # django-prometheus, under DefectDojo's login-exempt prefix
    static_configs:
      - targets: ['127.0.0.1:{{ vigil_dojo_port }}']
        labels: { pod: {{ vigil_name }} }
  - job_name: vigil-falcosidekick
    static_configs:
      - targets: ['127.0.0.1:{{ vigil_falcosidekick_port }}']
        labels: { pod: {{ vigil_name }} }
