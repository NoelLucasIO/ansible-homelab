# {{ ansible_managed }}
# Loaded via rule_files: /etc/prometheus/rules.d/*.yml
{% set long = vigil_containers | selectattr('kind', 'equalto', 'service') | map(attribute='name') | list %}
groups:
  - name: vigil
    rules:
      - alert: VigilDefectDojoDown
        expr: up{job="vigil-defectdojo"} == 0
        for: 10m
        labels: { severity: warning, pod: {{ vigil_name }} }
        annotations:
          summary: DefectDojo in the vigil pod is not answering /django_metrics/metrics

      - alert: VigilFalcosidekickDown
        expr: up{job="vigil-falcosidekick"} == 0
        for: 10m
        labels: { severity: warning, pod: {{ vigil_name }} }
        annotations:
          summary: Falcosidekick is not answering, so Falco alerts aren't reaching Loki

      # Falco events by priority, counted by Falcosidekick (priority_raw: lowercase name)
      - alert: VigilFalcoCriticalEvent
        expr: |
          sum by (rule, priority_raw, hostname) (
            increase(falcosecurity_falcosidekick_falco_events_total{priority_raw=~"{{ vigil_falco_alert_priority }}"}[15m])
          ) > 0
        labels: { severity: critical, pod: {{ vigil_name }} }
        annotations:
          summary: "Falco: {{ '{{' }} $labels.rule {{ '}}' }} ({{ '{{' }} $labels.priority_raw {{ '}}' }}) on {{ '{{' }} $labels.hostname {{ '}}' }}"
          description: 'Details in Loki: {source="syscall"} | json | rule="{{ '{{' }} $labels.rule {{ '}}' }}"'

      # podman_container_state: 2 = running (prometheus-podman-exporter)
      - alert: VigilContainerNotRunning
        expr: |
          (podman_container_state{scope="{{ vigil_podman_exporter_scope }}"}
            * on(id) group_left(name)
           podman_container_info{scope="{{ vigil_podman_exporter_scope }}", name=~"{{ long | join('|') }}"}) != 2
        for: 10m
        labels: { severity: warning, pod: {{ vigil_name }} }
        annotations:
          summary: "vigil container {{ '{{' }} $labels.name {{ '}}' }} is not running"

      # Quadlet runs containers with --rm, so a dead one disappears instead of showing "exited"
      - alert: VigilContainersMissing
        expr: |
          count(podman_container_info{scope="{{ vigil_podman_exporter_scope }}", name=~"{{ long | join('|') }}"})
            < {{ long | length }}
          or absent(podman_container_info{scope="{{ vigil_podman_exporter_scope }}", name=~"{{ long | join('|') }}"})
        for: 15m
        labels: { severity: warning, pod: {{ vigil_name }} }
        annotations:
          summary: "vigil pod is missing long-running containers (expected {{ long | length }})"
