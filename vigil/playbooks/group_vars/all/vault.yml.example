---
# CLI only: copy to vault.yml (git-ignored), fill in, then ansible-vault encrypt vault.yml
# In AAP these come from custom credentials instead (see README.md).
# Generate random values with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

# Shared with ipam-vm
nios_api_password: CHANGE_ME
npm_identity: CHANGE_ME                    # NPM login email
npm_secret: CHANGE_ME

# vigil
vigil_dojo_db_password: CHANGE_ME          # DefectDojo's role on the existing Postgres
vigil_dojo_admin_password: CHANGE_ME       # DefectDojo web login (user: admin)
vigil_dojo_secret_key: CHANGE_ME           # Django SECRET_KEY, 50+ chars: token_urlsafe(48)
vigil_dojo_aes_key: CHANGE_ME              # DD_CREDENTIAL_AES_256_KEY, exactly 32 chars: token_urlsafe(24)
vigil_gvm_admin_password: CHANGE_ME        # Greenbone web login (user: admin)
vigil_grafana_db_password: CHANGE_ME       # read-only vigil_ro role used by Grafana

# Optional: read-only git token for vigil_code_repos entries with auth: true
# (Forgejo/Gitea: Settings > Applications, scope read:repository; GitHub: fine-grained, Contents: read)
# vigil_git_token: CHANGE_ME
