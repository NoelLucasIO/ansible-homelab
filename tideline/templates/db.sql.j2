-- {{ ansible_managed }}
-- Roles and database for Tideline. Idempotent; runs as the container's postgres superuser.
SELECT format('CREATE ROLE %I NOLOGIN', '{{ tideline_db_owner }}')
 WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ tideline_db_owner }}')\gexec

SELECT format('CREATE DATABASE %I OWNER %I', '{{ tideline_db }}', '{{ tideline_db_owner }}')
 WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{ tideline_db }}')\gexec

SELECT format('CREATE ROLE %I LOGIN', '{{ tideline_grafana_db_user }}')
 WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ tideline_grafana_db_user }}')\gexec
ALTER ROLE "{{ tideline_grafana_db_user }}" WITH LOGIN PASSWORD '{{ tideline_grafana_db_password | replace("'", "''") }}';
ALTER ROLE "{{ tideline_grafana_db_user }}" SET default_transaction_read_only = on;
GRANT CONNECT ON DATABASE "{{ tideline_db }}" TO "{{ tideline_grafana_db_user }}";

\connect {{ tideline_db }}
SET client_min_messages = warning;
SET ROLE "{{ tideline_db_owner }}";
{{ lookup('ansible.builtin.file', (playbook_dir | dirname) ~ '/files/schema.sql') }}

GRANT USAGE ON SCHEMA tideline TO "{{ tideline_grafana_db_user }}";
GRANT SELECT ON ALL TABLES IN SCHEMA tideline TO "{{ tideline_grafana_db_user }}";
ALTER DEFAULT PRIVILEGES FOR ROLE "{{ tideline_db_owner }}" IN SCHEMA tideline
  GRANT SELECT ON TABLES TO "{{ tideline_grafana_db_user }}";
RESET ROLE;
