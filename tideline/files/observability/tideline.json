          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  (SELECT count(*) FROM tideline.hosts WHERE reboot_required AND host IN (${host:sqlstring})) AS \"Reboot needed\",\n  (SELECT coalesce(max(extract(day FROM now() - u.first_seen)), 0)::int FROM tideline.updates u\n    WHERE u.resolved_at IS NULL AND u.security AND u.host IN (${host:sqlstring})) AS \"Oldest security update (days)\",\n  (SELECT count(*) FROM tideline.hosts WHERE (last_success IS NULL OR last_success < now() - interval '30 hours')\n    AND host IN (${host:sqlstring})) AS \"Stale systems\",\n  (SELECT count(*) FROM tideline.hosts WHERE jsonb_array_length(last_errors) > 0 AND host IN (${host:sqlstring})) AS \"With errors\"\n"
        }
