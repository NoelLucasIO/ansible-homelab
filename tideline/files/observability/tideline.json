    {
      "type": "table",
      "title": "Advisories and release notes",
      "description": "One row per advisory (Fedora/RHEL errata, Arch AVGs), Debian changelog entry or upstream release. Description is the advisory's own text.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(u.advisory_id, u.name) AS \"Advisory\",\n  (array_agg(u.advisory_type ORDER BY CASE u.severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 ELSE CASE WHEN u.security THEN 4 ELSE 5 END END))[1] AS \"Type\",\n  (array_agg(CASE WHEN u.security THEN coalesce(u.severity, 'unrated') END ORDER BY CASE u.severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 ELSE CASE WHEN u.security THEN 4 ELSE 5 END END))[1] AS \"Severity\",\n  max(u.advisory_title) AS \"Title\",\n  string_agg(DISTINCT u.host, ', ') AS \"Systems\",\n  count(DISTINCT u.name) AS \"Packages\",\n  max(u.advisory_issued) AS \"Issued\",\n  string_agg(DISTINCT c.cve, ' ') AS \"CVEs\",\n  max(u.advisory_text) AS \"Description\",\n  max(u.advisory_url) AS advisory_url\nFROM tideline.updates u\nLEFT JOIN LATERAL unnest(u.cves) AS c(cve) ON true\nWHERE u.resolved_at IS NULL AND u.host IN (${host:sqlstring}) AND u.source IN (${source:sqlstring}) AND ('${scope}' = 'all' OR u.security) AND (${q:sqlstring} = '' OR u.name ILIKE '%' || ${q:sqlstring} || '%' OR coalesce(u.advisory_title, '') ILIKE '%' || ${q:sqlstring} || '%' OR coalesce(u.advisory_id, '') ILIKE '%' || ${q:sqlstring} || '%' OR array_to_string(u.cves, ' ') ILIKE '%' || ${q:sqlstring} || '%') AND (u.advisory_id IS NOT NULL OR u.advisory_text IS NOT NULL)\nGROUP BY coalesce(u.advisory_id, u.name)\nORDER BY min(CASE u.severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 ELSE CASE WHEN u.security THEN 4 ELSE 5 END END), max(u.advisory_issued) DESC NULLS LAST\nLIMIT 2000"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "high": {
                        "color": "orange",
                        "index": 1
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "low": {
                        "color": "blue",
                        "index": 3
                      },
                      "unrated": {
                        "color": "purple",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Advisory"
            },
            "properties": [
              {
                "id": "links",
