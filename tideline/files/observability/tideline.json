    {
      "type": "timeseries",
      "title": "Pending updates over time",
      "description": "Open updates at each point, from Tideline's history (starts when Tideline first ran).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d AS time, u.host AS metric, count(*) AS value\nFROM (SELECT generate_series(date_trunc('hour', $__timeFrom()::timestamptz), least($__timeTo()::timestamptz, now()), interval '6 hours')\n      UNION SELECT least($__timeTo()::timestamptz, now())) AS s(d)\nJOIN tideline.updates u ON u.first_seen <= d AND (u.resolved_at IS NULL OR u.resolved_at > d)\nWHERE u.host IN (${host:sqlstring}) AND u.source IN (${source:sqlstring}) AND ('${scope}' = 'all' OR u.security)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
