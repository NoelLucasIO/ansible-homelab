    {
      "type": "table",
      "title": "Systems",
      "description": "One row per system. Reboot: running kernel or libraries older than what's installed.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT h.host AS \"System\", h.kind AS \"Kind\", concat_ws(' ', h.os, h.os_version) AS \"OS\",\n  count(u.id) AS \"Pending\",\n  count(u.id) FILTER (WHERE u.security) AS \"Security\",\n  count(u.id) FILTER (WHERE u.security AND u.severity IN ('critical', 'high')) AS \"Crit/High\",\n  min(u.first_seen) AS \"Oldest pending\",\n  CASE WHEN h.reboot_required THEN 'yes' WHEN h.reboot_required IS NULL THEN '' ELSE 'no' END AS \"Reboot\",\n  h.kernel AS \"Kernel / build\",\n  array_to_string(h.managers, ', ') AS \"Checked\",\n  h.last_success AS \"Last success\",\n  (SELECT string_agg(e, ' | ') FROM jsonb_array_elements_text(h.last_errors) e) AS \"Errors\"\nFROM tideline.hosts h\nLEFT JOIN tideline.updates u ON u.host = h.host AND u.resolved_at IS NULL\nWHERE h.host IN (${host:sqlstring})\nGROUP BY h.host\nORDER BY \"Crit/High\" DESC, \"Security\" DESC, \"Pending\" DESC, h.host"
        }
      ],
