      }
    },
    {
      "type": "table",
      "title": "Applied or withdrawn (in the time range)",
      "description": "Updates a later run no longer offered: almost always because they were installed.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT u.resolved_at AS \"Resolved\", u.host AS \"System\", u.source AS \"Source\",\n  u.name AS \"Package\", u.installed_version AS \"From\", u.new_version AS \"To\",\n  CASE WHEN u.security THEN coalesce(u.severity, 'unrated') END AS \"Severity\",\n  u.advisory_id AS \"Advisory\", u.first_seen AS \"First seen\", u.advisory_url\nFROM tideline.updates u\nWHERE u.resolved_at BETWEEN $__timeFrom() AND $__timeTo()\n  AND u.host IN (${host:sqlstring}) AND u.source IN (${source:sqlstring})\nORDER BY u.resolved_at DESC\nLIMIT 2000"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
