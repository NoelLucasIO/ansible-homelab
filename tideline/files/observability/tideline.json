    {
      "type": "table",
      "title": "Appliances",
      "description": "From the tideline_appliances catalog you edit (AAP inventory variables). From = live when a probe read the running version, manual otherwise.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT name AS \"Appliance\", product AS \"Product\", vendor AS \"Vendor\",\n  installed_version AS \"Installed\", installed_source AS \"From\", installed_on AS \"Installed on\",\n  latest_version AS \"Latest\", latest_released AS \"Released\",\n  CASE WHEN update_available THEN 'update available' WHEN NOT update_available THEN 'current' ELSE 'unknown' END AS \"Status\",\n  notes AS \"Notes\", probe_error AS \"Probe error\", checked_at AS \"Checked\",\n  release_notes_url, download_url\nFROM tideline.appliances\nORDER BY update_available DESC NULLS LAST, name"
        }
