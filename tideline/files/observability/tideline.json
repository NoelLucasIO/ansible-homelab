            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"Pending\",\n  count(*) FILTER (WHERE u.security) AS \"Security\",\n  count(*) FILTER (WHERE u.security AND u.severity IN ('critical', 'high')) AS \"Critical / high\",\n  count(DISTINCT u.host) AS \"Systems with updates\"\nFROM tideline.updates u\nWHERE u.resolved_at IS NULL AND u.host IN (${host:sqlstring}) AND u.source IN (${source:sqlstring}) AND ('${scope}' = 'all' OR u.security) AND (${q:sqlstring} = '' OR u.name ILIKE '%' || ${q:sqlstring} || '%' OR coalesce(u.advisory_title, '') ILIKE '%' || ${q:sqlstring} || '%' OR coalesce(u.advisory_id, '') ILIKE '%' || ${q:sqlstring} || '%' OR array_to_string(u.cves, ' ') ILIKE '%' || ${q:sqlstring} || '%')"
        }
