    {
      "type": "table",
      "title": "Pending updates",
      "description": "Package links to its distro page; Advisory to the erratum, security advisory or release notes; Notes to the package's change history. Hover a cell and use Inspect to read long text.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tideline"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT u.host AS \"System\", u.source AS \"Source\", u.name AS \"Package\",\n  u.installed_version AS \"Installed\", u.installed_at AS \"Installed on\", u.new_version AS \"Available\",\n  CASE WHEN u.security THEN coalesce(u.severity, 'unrated') END AS \"Severity\",\n  u.advisory_type AS \"Type\",\n  coalesce(u.advisory_id, CASE WHEN u.advisory_url IS NOT NULL THEN 'release notes' END) AS \"Advisory\",\n  coalesce(u.advisory_title, u.summary) AS \"Notes\",\n  u.first_seen AS \"Pending since\", u.repo AS \"Repo\",\n  u.advisory_url, u.package_url, u.changes_url\nFROM tideline.updates u\nWHERE u.resolved_at IS NULL AND u.host IN (${host:sqlstring}) AND u.source IN (${source:sqlstring}) AND ('${scope}' = 'all' OR u.security) AND (${q:sqlstring} = '' OR u.name ILIKE '%' || ${q:sqlstring} || '%' OR coalesce(u.advisory_title, '') ILIKE '%' || ${q:sqlstring} || '%' OR coalesce(u.advisory_id, '') ILIKE '%' || ${q:sqlstring} || '%' OR array_to_string(u.cves, ' ') ILIKE '%' || ${q:sqlstring} || '%')\nORDER BY CASE u.severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 ELSE CASE WHEN u.security THEN 4 ELSE 5 END END, u.host, u.source, u.name\nLIMIT 5000"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
