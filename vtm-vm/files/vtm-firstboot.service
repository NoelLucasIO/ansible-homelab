[Unit]
Description=vtm-vm first boot: unattended vTM Initial Configuration
# After the appliance's own boot services have named the NICs and raised the network.
After=network-online.target z-nic-defaults.service z-apply-vmcustomizations.service z-initial-network.service
Wants=network-online.target
ConditionPathExists=/root/vtm-answers

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vtm-firstboot
# z-initial-config ends by daemonising start-zeus. The default KillMode (control-group) would kill
# the traffic manager and admin server along with this unit when the script exits.
KillMode=process
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
