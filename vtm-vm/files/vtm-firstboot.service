[Unit]
Description=vtm-vm first boot: unattended vTM Initial Configuration
# After the appliance's own boot services: NIC naming, network, sysconfig, and above all
# z-keys-create, which on a fresh image (/recreate-keys) generates a new control certificate.
# Running alongside it leaves global.cfg holding the old certificate ("Cluster: Error").
After=network-online.target z-nic-defaults.service z-apply-vmcustomizations.service z-initial-network.service z-apply-sysconfig.service z-keys-create.service
Wants=network-online.target
ConditionPathExists=/root/vtm-answers

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vtm-firstboot
# z-initial-config ends by daemonising start-zeus. The default KillMode (control-group) would kill
# the traffic manager and admin server along with this unit when the script exits.
KillMode=process
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
